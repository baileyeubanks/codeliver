{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contentco-op.com/schemas/codeliver-certification-manifest-v1.json",
  "title": "Co-Deliver certification manifest",
  "oneOf": [
    { "$ref": "#/$defs/pillar" },
    { "$ref": "#/$defs/journey" }
  ],
  "$defs": {
    "checkReference": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]+$"
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "pattern"],
      "properties": {
        "kind": { "enum": ["page", "api"] },
        "pattern": { "type": "string", "pattern": "^/" }
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "category", "severity", "horizon", "checks", "residualRisk"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["critical", "high", "medium", "low"] },
        "horizon": { "type": "integer", "minimum": 1, "maximum": 3 },
        "proofTtlDays": { "type": "integer", "minimum": 1 },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/checkReference" },
          "uniqueItems": true
        },
        "residualRisk": { "type": "string", "minLength": 1 }
      }
    },
    "pillar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "title",
        "horizons",
        "owner",
        "objective",
        "authorityDomains",
        "surfaces",
        "obligations",
        "slos"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "pillar" },
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "horizons": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "integer", "minimum": 1, "maximum": 3 },
          "uniqueItems": true
        },
        "owner": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "authorityDomains": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["identity", "tenant", "project", "version", "permission", "billing", "audit"] },
          "uniqueItems": true
        },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/surface" }
        },
        "obligations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/obligation" }
        },
        "slos": { "type": "array", "items": { "type": "object" } }
      }
    },
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "title",
        "horizon",
        "routes",
        "states",
        "viewports",
        "accessibility",
        "securityInvariants",
        "persistence",
        "concurrency",
        "degradedDependencies",
        "rollback",
        "performanceBudgets",
        "checks"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "journey" },
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "horizon": { "type": "integer", "minimum": 1, "maximum": 3 },
        "proofTtlDays": { "type": "integer", "minimum": 1 },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^/" },
          "uniqueItems": true
        },
        "states": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "viewports": { "type": "array", "minItems": 2, "items": { "type": "object" } },
        "accessibility": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "securityInvariants": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "persistence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "concurrency": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "degradedDependencies": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "rollback": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "performanceBudgets": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/checkReference" },
          "uniqueItems": true
        }
      }
    }
  }
}
