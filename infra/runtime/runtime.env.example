# Install as /Users/_mxappservice/.config/blaze-secrets/codeliver/runtime.env
# owned by _mxappservice with mode 0600. Values use shell assignment syntax.

NODE_ENV=production
PORT=4103
CODELIVER_BIND_HOST=127.0.0.1

ADMIN_SITE_URL=https://admin.contentco-op.com
NEXT_PUBLIC_ADMIN_SITE_URL=https://admin.contentco-op.com
CLIENT_SITE_URL=https://client.contentco-op.com
NEXT_PUBLIC_CLIENT_SITE_URL=https://client.contentco-op.com

# Required. Populate only in the private installed file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

CODELIVER_STORAGE_PROVIDER=ccnas
CODELIVER_STORAGE_WRITE_ENABLED=1
CODELIVER_HEALTH_REMOTE_PROBES=1
NAS_MEDIA_ROOT=/Volumes/BLAZE-STORE-2/media-vault/co-deliver

# Email remains optional until both this gate and its provider settings are configured.
CODELIVER_REQUIRE_NOTIFICATIONS=0
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional application integrations.
ANTHROPIC_API_KEY=
CODELIVER_MEDIA_PIPELINE_WORKER_TOKEN=
NOTIFICATION_WEBHOOK_SECRET=
FFMPEG_PATH=
FFPROBE_PATH=
