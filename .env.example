# Canonical origin-only URLs. Server and NEXT_PUBLIC values must match in production.
SITE_URL=https://co-videopro.com
NEXT_PUBLIC_SITE_URL=https://co-videopro.com
ADMIN_SITE_URL=https://co-videopro.com
NEXT_PUBLIC_ADMIN_SITE_URL=https://co-videopro.com
CLIENT_SITE_URL=https://co-videopro.com
NEXT_PUBLIC_CLIENT_SITE_URL=https://co-videopro.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://briokwdoonawhxisbydy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=
SUPABASE_SERVICE_KEY=your-service-key
# Required on every production surface after the isolated authority is staged.
SUPABASE_DATA_SCHEMA=co_production
NEXT_PUBLIC_SUPABASE_DATA_SCHEMA=co_production
# 32 random bytes encoded as base64url. Encrypts recoverable invite secrets at rest.
CO_PRODUCTION_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64url-key
# Separate 32-byte base64url key for recoverable webhook signing secrets.
CO_PRODUCTION_WEBHOOK_SECRET_ENCRYPTION_KEY=replace-with-a-different-32-byte-base64url-key
# Separate 32-byte base64url HMAC key for daily, invite-scoped viewer address hashes.
CO_PRODUCTION_ANALYTICS_HASH_KEY=replace-with-a-third-32-byte-base64url-key
# Accepted Proposal Studio handoffs validate in dry-run mode by default.
# Enable only after the isolated migration, RLS, and activation journey are certified.
PROPOSAL_HANDOFF_WRITES_ENABLED=false
# 32 random bytes encoded as base64url. This independent receiver proof must
# match the integration binding and is required even for service-role callers.
PROPOSAL_HANDOFF_RECEIVER_HMAC_SECRET=replace-with-32-byte-base64url-secret

# Email (optional)
RESEND_API_KEY=your-resend-key
RESEND_FROM_EMAIL=noreply@codeliver.app

# AI (optional — enables comment summarization)
ANTHROPIC_API_KEY=your-anthropic-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Explicit privacy gate for sending asset metadata and feedback to an external AI provider.
CODELIVER_AI_EXTERNAL_PROCESSING_ENABLED=false
