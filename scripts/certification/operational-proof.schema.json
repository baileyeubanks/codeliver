{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contentco-op.com/schemas/codeliver-operational-proof-v1.json",
  "title": "Co-Deliver operational certification proof",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "checkId", "commit", "sourceFingerprint", "capturedAt", "status", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "checkId": { "type": "string" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "sourceFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "status": { "const": "pass" },
    "environment": { "type": "string" },
    "artifacts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "metrics": { "type": "object" },
    "notes": { "type": "string" }
  }
}
